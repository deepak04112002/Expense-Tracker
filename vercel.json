{
  "version": 2,
  "buildCommand": "turbo run build --filter=backend...",
  "outputDirectory": "apps/backend/dist",
  "functions": {
    "apps/backend/src/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/backend/src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 0 * * *"
    }
  ]
}
